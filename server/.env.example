NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=your-jwt-secret-must-be-long-and-random
ADMIN_EMAIL=admin@trustchain.com
ADMIN_PASSWORD_HASH=$2b$10$your-hashed-password-here

# ─── XDC Apothem Blockchain ───────────────────────────────────────────
# Get XDC from the Apothem faucet: https://faucet.apothem.network
RPC_URL=https://rpc.apothem.network
CONTRACT_ADDRESS=0xYourContractAddressHere
PRIVATE_KEY=0xYourPrivateKeyHere

# ─── Zero-Knowledge Proof Secret ──────────────────────────────────────
# Used for local proof generation/verification fallback
ZK_SECRET=your-zk-secret-here

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ─── Blockchain Health Check (optional) ─────────────────────────────
BLOCKCHAIN_POLL_INTERVAL=15000
BLOCKCHAIN_MAX_RETRIES=3
BLOCKCHAIN_RETRY_DELAY=2000
